# FPTecnologi-HUB · Dashboard — variables de entorno.
# Copia este archivo a .env.local y ajusta los valores para tu máquina.

# URL base de la API central NestJS (ver ../../apps/api).
NEXT_PUBLIC_API_URL=http://localhost:3001

# URL pública de la web (para los botones "Ver" y la vista previa de landings y blog). En producción: https://www.tudominio.com
NEXT_PUBLIC_WEB_PUBLICA_URL=http://localhost:3002

