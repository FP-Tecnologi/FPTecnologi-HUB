// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider      = "prisma-client"
  output        = "../src/generated/prisma"
  // El hosting (Linux) usa OpenSSL 1.1 y el equipo de compilación OpenSSL 3: se generan los motores de ambos.
  binaryTargets = ["native", "debian-openssl-1.1.x", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Multi-tenant core: Marca (brand/tenant) + Sitio (domain -> brand)
// ---------------------------------------------------------------------------

model Marca {
  id               String   @id @default(uuid())
  nombre           String
  logo             String?
  colorPrimario    String?
  colorSecundario  String?
  contactoEmail    String?
  contactoTelefono String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  sitios             Sitio[]
  usuarios           UsuarioMarcaRol[]
  categorias         Categoria[]
  productos          Producto[]
  pedidos            Pedido[]
  servicios          Servicio[]
  proyectos          Proyecto[]
  clientes           Cliente[]
  cotizaciones       Cotizacion[]
  notificaciones     Notificacion[]
  chatAsesores       ChatAsesor[]
  tarjetasDigitales  TarjetaDigital[]
  chatConversaciones ChatConversacion[]
  chatMensajes       ChatMensaje[]
  contenidos         ContenidoWeb[]
  blogArticulos      BlogArticulo[]
  leadsCotizador     LeadCotizador[]
  contactosWeb       ContactoWeb[]
  suscriptores       SuscriptorBoletin[]
  invitaciones       Invitacion[]
  tarifasEnvio       TarifaEnvio[]
  cotizacionEnvios   CotizacionEnvio[]
  campanas           Campana[]
  landings           Landing[]
  popups             Popup[]
  landingRegistros   LandingRegistro[]
  codigosCuenta      CodigoCuenta[]
  conocimientoDocs   ConocimientoDocumento[]
  conocimientoFrags  ConocimientoFragmento[]
  conocimientoPend   ConocimientoPendiente[]
  presupuestos       Presupuesto[]
  tickets            Ticket[]
  socios             Socio[]
  recursos           Recurso[]
}

model Sitio {
  id        String   @id @default(uuid())
  dominio   String   @unique
  marcaId   String
  marca     Marca    @relation(fields: [marcaId], references: [id])
  createdAt DateTime @default(now())

  @@index([marcaId])
}

// ---------------------------------------------------------------------------
// Usuarios, autenticación (JWT + refresh token) y 2FA por OTP
// ---------------------------------------------------------------------------

model Usuario {
  id              String   @id @default(uuid())
  email           String   @unique
  passwordHash    String
  nombre          String?
  avatarUrl       String?
  dni             String?
  telefono        String?
  cargo           String?
  activo          Boolean  @default(true)
  // Default true a propósito: la migración marca a todos los usuarios ya
  // existentes como "ya la vio" (nadie que ya usa el sistema debe recibir
  // el modal de bienvenida). register()/loginOrRegisterGoogle() la ponen
  // en false explícitamente al crear una cuenta nueva.
  bienvenidaVista Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  // TOTP (app autenticadora) — método de 2FA alternativo al OTP por
  // correo. totpSecret se guarda desde /auth/totp/setup pero no habilita
  // nada hasta que /auth/totp/enable confirma un código válido.
  totpSecret  String?
  totpEnabled Boolean @default(false)

  marcas                 UsuarioMarcaRol[]
  refreshTokens          RefreshToken[]
  otpCodes               OtpCode[]
  totpBackupCodes        TotpBackupCode[]
  pedidos                Pedido[]
  notificaciones         Notificacion[]
  dispositivosConfiables DispositivoConfiable[]
  chatsAtendidos         ChatConversacion[]
}

// "Confiar en este dispositivo por 30 días": al confirmar el 2FA se guarda un
// token (hasheado, nunca el valor crudo) atado a este usuario. login() lo
// verifica antes de pedir OTP/TOTP de nuevo; cambiar la contraseña revoca
// todos los de este usuario, igual que RefreshToken.
model DispositivoConfiable {
  id        String   @id @default(uuid())
  usuarioId String
  usuario   Usuario  @relation(fields: [usuarioId], references: [id])
  tokenHash String
  expiresAt DateTime
  revoked   Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([usuarioId])
}

model TotpBackupCode {
  id         String    @id @default(uuid())
  usuarioId  String
  usuario    Usuario   @relation(fields: [usuarioId], references: [id])
  codigoHash String
  usedAt     DateTime?
  createdAt  DateTime  @default(now())

  @@index([usuarioId])
}

model RefreshToken {
  id        String   @id @default(uuid())
  tokenHash String
  usuarioId String
  usuario   Usuario  @relation(fields: [usuarioId], references: [id])
  expiresAt DateTime
  revoked   Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([usuarioId])
}

enum OtpProposito {
  LOGIN_2FA
  RESET_PASSWORD
}

model OtpCode {
  id         String       @id @default(uuid())
  usuarioId  String
  usuario    Usuario      @relation(fields: [usuarioId], references: [id])
  codigoHash String
  proposito  OtpProposito @default(LOGIN_2FA)
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime     @default(now())

  @@index([usuarioId])
}

// ---------------------------------------------------------------------------
// Roles y permisos por marca: un usuario puede tener un rol distinto en cada marca
// ---------------------------------------------------------------------------

model Rol {
  id           String            @id @default(uuid())
  nombre       String            @unique // admin, marketing, ventas, etc.
  usuarios     UsuarioMarcaRol[]
  invitaciones Invitacion[]
}

// Invitación por correo a un miembro del equipo. Solo se guarda el hash del
// token (el enlace con el token en claro viaja únicamente por correo). No está
// en TENANT_MODELS a propósito: el invitado la consulta por token sin marcaId.
model Invitacion {
  id          String    @id @default(uuid())
  marcaId     String
  marca       Marca     @relation(fields: [marcaId], references: [id])
  rolId       String
  rol         Rol       @relation(fields: [rolId], references: [id])
  email       String
  tokenHash   String    @unique
  expiresAt   DateTime
  aceptadaAt  DateTime?
  invitadoPor String? // correo de quien envió la invitación
  createdAt   DateTime  @default(now())

  @@index([marcaId, createdAt])
}

model UsuarioMarcaRol {
  usuarioId String
  marcaId   String
  rolId     String
  usuario   Usuario  @relation(fields: [usuarioId], references: [id])
  marca     Marca    @relation(fields: [marcaId], references: [id])
  rol       Rol      @relation(fields: [rolId], references: [id])
  createdAt DateTime @default(now())

  @@id([usuarioId, marcaId, rolId])
  @@index([marcaId])
}

// ---------------------------------------------------------------------------
// Catálogo: categorías y productos (siempre filtrados server-side por marcaId)
// ---------------------------------------------------------------------------

model Categoria {
  id         String     @id @default(uuid())
  marcaId    String
  marca      Marca      @relation(fields: [marcaId], references: [id])
  nombre     String
  slug       String? // URL amigable por marca (se genera desde el nombre)
  orden      Int        @default(0)
  activo     Boolean    @default(true)
  portadaUrl String?
  productos  Producto[]
  createdAt  DateTime   @default(now())

  @@unique([marcaId, slug])
}

model Producto {
  id              String       @id @default(uuid())
  marcaId         String
  marca           Marca        @relation(fields: [marcaId], references: [id])
  categoriaId     String?
  categoria       Categoria?   @relation(fields: [categoriaId], references: [id])
  nombre          String
  descripcion     String?
  sku             String
  slug            String? // URL amigable por marca (importador WooCommerce lo genera)
  precio          Decimal
  precioAntes     Decimal? // precio tachado (oferta), null = sin oferta
  precioMayorista Decimal? // precio para clientes mayoristas (min. 6 u.); null = se usa `precio`
  moneda          String       @default("USD") // precios base en USD sin IGV
  marcaComercial  String? // marca del fabricante (Dell, HP, Lenovo…) — distinto de Marca (tenant)
  imagenes        String[]     @default([]) // URLs de fotos, la primera es la portada
  destacado       Boolean      @default(false)
  stock           Int          @default(0)
  activo          Boolean      @default(true)
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  pedidoItems     PedidoItem[]

  @@unique([marcaId, sku])
  @@unique([marcaId, slug])
  @@index([marcaId, activo, categoriaId])
}

// ---------------------------------------------------------------------------
// Pedidos (estructura base, sin pasarela de pago conectada todavía)
// ---------------------------------------------------------------------------

enum EstadoPedido {
  PENDIENTE
  PAGADO
  ENVIADO
  ENTREGADO
  CANCELADO
}

model Pedido {
  id                String       @id @default(uuid())
  marcaId           String
  marca             Marca        @relation(fields: [marcaId], references: [id])
  numeroPedido      String? // correlativo humano (FP-2026-0001), único por marca
  clienteId         String?
  cliente           Usuario?     @relation(fields: [clienteId], references: [id])
  // Datos del comprador invitado (checkout sin pasarela, fase 1)
  nombre            String       @default("")
  email             String       @default("")
  celular           String       @default("")
  documento         String?
  direccion         String?
  distrito          String?
  notas             String?
  estado            EstadoPedido @default(PENDIENTE)
  subtotal          Decimal      @default(0) // suma de items, sin IGV
  igv               Decimal      @default(0) // 18% del subtotal
  envio             Decimal      @default(0) // 0 = gratis en fase 1
  descuento         Decimal      @default(0)
  total             Decimal      @default(0)
  moneda            String       @default("USD")
  estadoPago        String       @default("PENDIENTE") // PENDIENTE | POR_CONFIRMAR (fase 1: se coordina por WhatsApp)
  metodoPago        String? // TRANSFERENCIA | YAPE | PLIN | EFECTIVO…
  // Envío por courier (Shalom): se fija server-side desde TarifaEnvio al crear el pedido.
  envioProveedor    String?
  envioDepartamento String?
  envioSede         String? // agencia donde recoge el cliente
  envioPlazo        String? // "2-3 días"
  trackingCodigo    String? // lo registra el equipo al despachar
  items             PedidoItem[]
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  @@unique([marcaId, numeroPedido])
  @@index([marcaId, createdAt])
  @@index([marcaId, email])
  @@index([marcaId, estado, createdAt])
}

model PedidoItem {
  id             String   @id @default(uuid())
  pedidoId       String
  pedido         Pedido   @relation(fields: [pedidoId], references: [id])
  productoId     String
  producto       Producto @relation(fields: [productoId], references: [id])
  cantidad       Int
  precioUnitario Decimal // precio al momento de la compra (sin IGV)
  nombreSnapshot String   @default("") // nombre del producto al momento de la compra
  skuSnapshot    String   @default("") // SKU al momento de la compra
  igvUnitario    Decimal  @default(0)
  subtotal       Decimal  @default(0) // (precioUnitario + igvUnitario) * cantidad

  @@index([pedidoId])
  @@index([productoId])
}

// ---------------------------------------------------------------------------
// Servicios IT (catálogo de soluciones) + Cotizaciones
// ---------------------------------------------------------------------------

model Servicio {
  id           String       @id @default(uuid())
  marcaId      String
  marca        Marca        @relation(fields: [marcaId], references: [id])
  nombre       String
  /// Descripción corta (tarjeta y encabezado de la página del servicio).
  descripcion  String?
  precioDesde  Decimal?
  activo       Boolean      @default(true)
  // --- Contenido de la página pública (/servicios/[slug]), editable desde el dashboard ---
  slug         String?
  /// Etiqueta sobre el título ("Somos expertos en", "Soluciones para"…).
  etiqueta     String?
  /// Clave del ícono del catálogo de la web (shield, server, cloud…).
  icono        String?
  imagenUrl    String?
  intro        String?
  incluye      String[]     @default([])
  /// [{ titulo, texto }]
  beneficios   Json         @default("[]")
  sectores     String[]     @default([])
  /// [{ p, r }] (pregunta, respuesta)
  faqs         Json         @default("[]")
  orden        Int          @default(0)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  cotizaciones Cotizacion[]

  @@unique([marcaId, slug])
}

/// Proyecto de referencia que se muestra en /proyectos y en el home.
model Proyecto {
  id           String   @id @default(uuid())
  marcaId      String
  marca        Marca    @relation(fields: [marcaId], references: [id])
  titulo       String
  /// Id del departamento (lib/peruDepartments.ts de la web): lima, cajamarca…
  departamento String
  imagenUrl    String?
  cliente      String
  anio         Int
  descripcion  String   @default("")
  alcance      String[] @default([])
  orden        Int      @default(0)
  activo       Boolean  @default(true)
  /// Dato de muestra: no se le pasa al asistente virtual como caso real.
  esEjemplo    Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([marcaId])
}

/// Cliente que se muestra en la sección "Nuestros clientes".
model Cliente {
  id        String   @id @default(uuid())
  marcaId   String
  marca     Marca    @relation(fields: [marcaId], references: [id])
  nombre    String
  /// Iniciales para el logo provisional cuando no hay logoUrl.
  sigla     String
  logoUrl   String?
  /// gobierno | educacion | privado
  sector    String
  orden     Int      @default(0)
  activo    Boolean  @default(true)
  esEjemplo Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([marcaId])
}

enum EstadoCotizacion {
  PENDIENTE
  EN_REVISION
  ENVIADA
  ACEPTADA
  RECHAZADA
}

model Cotizacion {
  id              String            @id @default(uuid())
  marcaId         String
  marca           Marca             @relation(fields: [marcaId], references: [id])
  numero          String? // correlativo humano COT-AAAA-XXXXXX, único por marca
  servicioId      String
  servicio        Servicio          @relation(fields: [servicioId], references: [id])
  clienteNombre   String
  clienteEmail    String
  clienteTelefono String?
  clienteEmpresa  String?
  mensaje         String? // lo que pidió el cliente
  origen          String? // página desde donde llegó
  estado          EstadoCotizacion  @default(PENDIENTE)
  // Propuesta que prepara el equipo y se envía al cliente (correo o WhatsApp)
  propuesta       String?
  monto           Decimal?
  moneda          String            @default("USD")
  validezHasta    DateTime?
  notas           String? // internas
  atendidoPor     String? // email del usuario que la gestionó por última vez
  enviadaAt       DateTime?
  envios          CotizacionEnvio[]
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  @@unique([marcaId, numero])
  @@index([marcaId, clienteEmail])
  @@index([marcaId, createdAt])
  @@index([marcaId, estado, createdAt])
}

// Cada vez que se envía una cotización al cliente (historial por cliente).
model CotizacionEnvio {
  id           String     @id @default(uuid())
  marcaId      String
  marca        Marca      @relation(fields: [marcaId], references: [id])
  cotizacionId String
  cotizacion   Cotizacion @relation(fields: [cotizacionId], references: [id], onDelete: Cascade)
  canal        String // EMAIL | WHATSAPP
  destinatario String // correo o celular
  mensaje      String
  enviadoPor   String // email del usuario
  createdAt    DateTime   @default(now())

  @@index([marcaId, cotizacionId])
}

// ---------------------------------------------------------------------------
// Notificaciones internas (centro de notificaciones del dashboard)
// ---------------------------------------------------------------------------

enum TipoNotificacion {
  SISTEMA
  PEDIDO
  COTIZACION
  EQUIPO
  STOCK
  CHAT
}

model Notificacion {
  id        String           @id @default(uuid())
  marcaId   String?
  marca     Marca?           @relation(fields: [marcaId], references: [id])
  usuarioId String
  usuario   Usuario          @relation(fields: [usuarioId], references: [id])
  titulo    String
  mensaje   String
  tipo      TipoNotificacion @default(SISTEMA)
  leida     Boolean          @default(false)
  createdAt DateTime         @default(now())

  @@index([usuarioId, createdAt])
  @@index([marcaId])
  @@index([usuarioId, leida])
}

// ---------------------------------------------------------------------------
// Chat de la web pública: asesores de WhatsApp (perfiles que muestra el
// widget) + conversaciones del asistente virtual, que un asesor puede leer
// y retomar desde el dashboard. El visitante no tiene cuenta: accede a su
// conversación con un `token` secreto que solo tiene su navegador.
// ---------------------------------------------------------------------------

model ChatAsesor {
  id        String   @id @default(uuid())
  marcaId   String
  marca     Marca    @relation(fields: [marcaId], references: [id])
  nombre    String
  area      String
  telefono  String // como se muestra: "999 999 999"
  whatsapp  String // solo dígitos con código de país, para wa.me: "51999999999"
  fotoUrl   String?
  // Miembro del equipo al que pertenece el perfil (se asigna desde Usuarios y equipo); null = perfil suelto.
  usuarioId String?
  activo    Boolean  @default(true)
  orden     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([marcaId, usuarioId])
}

enum EstadoChat {
  BOT // atendida por el asistente virtual
  ASESOR // un asesor la tomó desde el dashboard
  CERRADA
}

enum AutorChat {
  CLIENTE
  BOT
  ASESOR
  SISTEMA // eventos: se unió, devolvió al asistente, finalizó, reabrió
}

model ChatConversacion {
  id           String        @id @default(uuid())
  marcaId      String
  marca        Marca         @relation(fields: [marcaId], references: [id])
  token        String        @unique
  titulo       String?
  estado       EstadoChat    @default(BOT)
  asesorId     String?
  asesor       Usuario?      @relation(fields: [asesorId], references: [id])
  paginaOrigen String?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  mensajes     ChatMensaje[]

  @@index([marcaId, updatedAt])
}

model ChatMensaje {
  id             String           @id @default(uuid())
  marcaId        String
  marca          Marca            @relation(fields: [marcaId], references: [id])
  conversacionId String
  conversacion   ChatConversacion @relation(fields: [conversacionId], references: [id], onDelete: Cascade)
  autor          AutorChat
  texto          String
  createdAt      DateTime         @default(now())

  @@index([conversacionId, createdAt])
  @@index([marcaId])
}

// ---------------------------------------------------------------------------
// CMS de las webs públicas: contenido editable por página y sección (textos,
// botones, listas, mostrar/ocultar). `datos` es JSON libre: la forma de cada
// sección la define la web que lo consume (ej. web-fptecnologi/src/lib/
// homeContenido.ts), que además tiene los valores por defecto.
// ---------------------------------------------------------------------------

model ContenidoWeb {
  id             String   @id @default(uuid())
  marcaId        String
  marca          Marca    @relation(fields: [marcaId], references: [id])
  pagina         String // "home", "nosotros", ...
  seccion        String // "hero", "servicios", ...
  datos          Json
  actualizadoPor String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([marcaId, pagina, seccion])
  @@index([marcaId, pagina])
}

// ---------------------------------------------------------------------------
// Blog de las webs públicas (CMS de artículos desde el dashboard). El
// contenido es Markdown; la web lo convierte a HTML. Solo PUBLICADO se ve.
// ---------------------------------------------------------------------------

enum EstadoArticulo {
  BORRADOR
  PUBLICADO
}

model BlogArticulo {
  id          String         @id @default(uuid())
  marcaId     String
  marca       Marca          @relation(fields: [marcaId], references: [id])
  titulo      String
  slug        String
  resumen     String
  contenido   String
  portadaUrl  String?
  categoria   String
  etiquetas   String[]
  autorNombre String
  estado      EstadoArticulo @default(BORRADOR)
  destacado   Boolean        @default(false)
  publicadoEn DateTime?
  creadoPor   String?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  @@unique([marcaId, slug])
  @@index([marcaId, estado, publicadoEn])
}

// ---------------------------------------------------------------------------
// Cotizador web: leads del formulario público /cotizador
// ---------------------------------------------------------------------------
// Distinto de `Cotizacion` (que cuelga de un Servicio concreto): el lead del
// cotizador es el primer contacto — "quiero cotizar X" — y el equipo comercial
// lo gestiona (estado, notas) hasta convertirlo en cotización/venta.

enum TipoPersona {
  NATURAL
  JURIDICA
}

enum EstadoLead {
  NUEVO
  CONTACTADO
  COTIZADO
  GANADO
  PERDIDO
}

model LeadCotizador {
  id            String      @id @default(uuid())
  marcaId       String
  marca         Marca       @relation(fields: [marcaId], references: [id])
  nombres       String
  apellidos     String
  tipoPersona   TipoPersona
  tipoDocumento String // DNI | RUC
  nroDocumento  String
  empresa       String?
  email         String
  celular       String
  interes       String // servicio/producto elegido (texto del momento)
  mensaje       String?
  origen        String? // página desde donde llegó
  estado        EstadoLead  @default(NUEVO)
  notas         String?
  atendidoPor   String? // email del usuario que lo gestionó por última vez
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@index([marcaId, estado, createdAt])
}

// ---------------------------------------------------------------------------
// Boletín: suscriptores del formulario del pie de página de la web
// ---------------------------------------------------------------------------

model SuscriptorBoletin {
  id        String   @id @default(uuid())
  marcaId   String
  marca     Marca    @relation(fields: [marcaId], references: [id])
  email     String
  origen    String? // página donde se suscribió
  createdAt DateTime @default(now())

  @@unique([marcaId, email])
  @@index([marcaId, createdAt])
}

// ---------------------------------------------------------------------------
// Contacto web: consultas del formulario de contacto y reclamos del Libro de
// Reclamaciones de las webs públicas
// ---------------------------------------------------------------------------

enum TipoContacto {
  CONTACTO
  RECLAMO
}

enum EstadoContacto {
  NUEVO
  CONTACTADO
  RESUELTO
  DESCARTADO
}

model ContactoWeb {
  id          String         @id @default(uuid())
  marcaId     String
  marca       Marca          @relation(fields: [marcaId], references: [id])
  tipo        TipoContacto   @default(CONTACTO)
  nombre      String
  email       String
  celular     String?
  empresa     String?
  mensaje     String
  origen      String? // página desde donde llegó
  estado      EstadoContacto @default(NUEVO)
  notas       String?
  atendidoPor String? // email del usuario que lo gestionó por última vez
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  @@index([marcaId, estado, createdAt])
}

// ---------------------------------------------------------------------------
// Envíos: tarifario por departamento (Shalom u otro courier). El costo va en la
// moneda del pedido (USD), sin IGV adicional: el courier factura aparte.
// ---------------------------------------------------------------------------

model TarifaEnvio {
  id           String   @id @default(uuid())
  marcaId      String
  marca        Marca    @relation(fields: [marcaId], references: [id])
  proveedor    String   @default("SHALOM")
  departamento String
  costo        Decimal // en `moneda` (las tarifas de Shalom se cargan en soles)
  moneda       String   @default("PEN") // PEN o USD; el pedido se cotiza en USD (base) convirtiendo con el tipo de cambio del sitio
  plazoDias    String? // texto libre: "2-3 días"
  sedes        String[] @default([]) // agencias disponibles en ese departamento
  activo       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([marcaId, proveedor, departamento])
}

// ---------------------------------------------------------------------------
// Campañas y landing pages (eventos, ofertas, captación). El contenido y el
// formulario de cada landing son JSON editables desde el dashboard; los
// registros guardan lo que respondió cada persona.
// ---------------------------------------------------------------------------

enum EstadoCampana {
  BORRADOR
  ACTIVA
  FINALIZADA
}

enum EstadoLanding {
  BORRADOR
  PUBLICADA
}

model Campana {
  id          String        @id @default(uuid())
  marcaId     String
  marca       Marca         @relation(fields: [marcaId], references: [id])
  nombre      String
  descripcion String?
  objetivo    String?
  estado      EstadoCampana @default(BORRADOR)
  inicio      DateTime?
  fin         DateTime?
  presupuesto Decimal?
  moneda      String        @default("PEN")
  landings    Landing[]
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([marcaId, estado])
}

model Landing {
  id         String            @id @default(uuid())
  marcaId    String
  marca      Marca             @relation(fields: [marcaId], references: [id])
  campanaId  String?
  campana    Campana?          @relation(fields: [campanaId], references: [id], onDelete: SetNull)
  slug       String // URL pública: /l/<slug>
  nombre     String
  plantilla  String // evento | oferta | captacion
  estado     EstadoLanding     @default(BORRADOR)
  contenido  Json
  formulario Json
  registros  LandingRegistro[]
  createdAt  DateTime          @default(now())
  updatedAt  DateTime          @updatedAt

  @@unique([marcaId, slug])
  @@index([marcaId, estado])
}

model LandingRegistro {
  id        String   @id @default(uuid())
  marcaId   String
  marca     Marca    @relation(fields: [marcaId], references: [id])
  landingId String
  landing   Landing  @relation(fields: [landingId], references: [id], onDelete: Cascade)
  datos     Json // respuestas por id de campo
  nombre    String?
  email     String?
  celular   String?
  origen    String? // utm / página de origen
  createdAt DateTime @default(now())

  @@index([marcaId, landingId, createdAt])
}

// ---------------------------------------------------------------------------
// "Mi cuenta" del cliente en la web pública: acceso SIN contraseña con un código
// de un solo uso enviado al correo (solo si ese correo tiene pedidos o
// cotizaciones). No crea usuarios: la sesión es un token firmado por correo.
// ---------------------------------------------------------------------------

model CodigoCuenta {
  id         String    @id @default(uuid())
  marcaId    String
  marca      Marca     @relation(fields: [marcaId], references: [id])
  email      String
  codigoHash String
  intentos   Int       @default(0)
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([marcaId, email, createdAt])
}

// ---------------------------------------------------------------------------
// Conocimiento del asistente virtual: documentos (Word, Excel, PDF, texto) que el
// equipo sube se leen UNA sola vez al cargarlos y se guardan troceados en
// fragmentos indexados (búsqueda de texto completo de Postgres, GIN); el chat
// solo trae los 3-5 fragmentos relevantes a cada pregunta, nunca el documento.
// Las respuestas oficiales escritas a mano son fragmentos con origen MANUAL.
// ---------------------------------------------------------------------------

enum OrigenConocimiento {
  DOCUMENTO
  MANUAL
}

model ConocimientoDocumento {
  id         String                  @id @default(uuid())
  marcaId    String
  marca      Marca                   @relation(fields: [marcaId], references: [id])
  nombre     String
  tipo       String // docx | xlsx | pdf | txt | md | csv
  tamano     Int
  fragmentos Int                     @default(0)
  activo     Boolean                 @default(true)
  subidoPor  String?
  items      ConocimientoFragmento[]
  createdAt  DateTime                @default(now())
  updatedAt  DateTime                @updatedAt

  @@index([marcaId, createdAt])
}

model ConocimientoFragmento {
  id          String                   @id @default(uuid())
  marcaId     String
  marca       Marca                    @relation(fields: [marcaId], references: [id])
  documentoId String?
  documento   ConocimientoDocumento?   @relation(fields: [documentoId], references: [id], onDelete: Cascade)
  origen      OrigenConocimiento       @default(DOCUMENTO)
  titulo      String
  texto       String
  indice      String // titulo + texto en minúsculas y sin tildes: es lo que se indexa
  // Columna generada por Postgres (to_tsvector('spanish', indice)) + índice GIN: ver la migración.
  busqueda    Unsupported("tsvector")?
  activo      Boolean                  @default(true)
  orden       Int                      @default(0)
  createdAt   DateTime                 @default(now())

  @@index([marcaId, activo, origen])
  @@index([documentoId])
}

// Preguntas que los visitantes hicieron y el asistente no tenía de dónde responder.
model ConocimientoPendiente {
  id        String   @id @default(uuid())
  marcaId   String
  marca     Marca    @relation(fields: [marcaId], references: [id])
  pregunta  String
  clave     String // pregunta normalizada, para contar repetidas
  veces     Int      @default(1)
  resuelta  Boolean  @default(false)
  ultimaVez DateTime @default(now())

  @@unique([marcaId, clave])
  @@index([marcaId, resuelta, veces])
}

// ---------------------------------------------------------------------------
// Popups de aviso de la web pública (Web informativa → Popups)
// ---------------------------------------------------------------------------

enum EstadoPopup {
  BORRADOR
  ACTIVO
  PAUSADO
}

model Popup {
  id              String      @id @default(uuid())
  marcaId         String
  marca           Marca       @relation(fields: [marcaId], references: [id])
  /// Nombre interno (solo se ve en el dashboard).
  nombre          String
  /// aviso | promocion | descuento | evento | producto — define los campos del contenido.
  plantilla       String
  /// modal | esquina | barra — cómo se presenta en la web.
  formato         String      @default("modal")
  estado          EstadoPopup @default(BORRADOR)
  /// Título, texto, imagen, código, botón, colores… (forma en popups.modelo.ts).
  contenido       Json
  /// Producto al que redirige el botón (si la acción es "producto").
  productoId      String?
  /// Mayor número = se muestra primero cuando coinciden varios en una página.
  prioridad       Int         @default(0)
  /// carga | retraso | scroll | salida
  disparador      String      @default("retraso")
  /// Segundos (retraso) o % de scroll (scroll).
  disparadorValor Int         @default(5)
  /// siempre | sesion | una_vez | horas | dias
  frecuencia      String      @default("sesion")
  frecuenciaValor Int         @default(1)
  /// Claves de página donde aparece (home, tienda, producto…) o "todas".
  paginas         String[]    @default([])
  /// todos | escritorio | movil
  dispositivo     String      @default("todos")
  inicio          DateTime?
  fin             DateTime?
  vistas          Int         @default(0)
  clics           Int         @default(0)
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  @@index([marcaId, estado])
}

// ---------------------------------------------------------------------------
// Presupuestos de productos (clientes mayoristas): documento tipo boleta con
// precios de mayorista, generado desde el carrito (mínimo 6 unidades por producto).
// ---------------------------------------------------------------------------

model Presupuesto {
  id               String            @id @default(uuid())
  marcaId          String
  marca            Marca             @relation(fields: [marcaId], references: [id])
  numero           String // correlativo humano COT-AAAA-XXXXXX, único por marca
  estado           EstadoCotizacion  @default(PENDIENTE)
  clienteNombre    String
  clienteDocumento String? // RUC o DNI
  clienteEmail     String
  clienteTelefono  String?
  clienteDireccion String?
  notas            String?
  moneda           String            @default("USD")
  subtotal         Decimal
  igv              Decimal
  total            Decimal
  validezHasta     DateTime
  origen           String?
  items            PresupuestoItem[]
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  @@unique([marcaId, numero])
  @@index([marcaId, createdAt])
  @@index([marcaId, estado, createdAt])
}

model PresupuestoItem {
  id             String      @id @default(uuid())
  presupuestoId  String
  presupuesto    Presupuesto @relation(fields: [presupuestoId], references: [id], onDelete: Cascade)
  productoId     String?
  sku            String
  nombre         String
  cantidad       Int
  precioLista    Decimal // precio normal (sin IGV)
  precioUnitario Decimal // precio aplicado (mayorista si existe)
  mayorista      Boolean     @default(false)
  subtotal       Decimal

  @@index([presupuestoId])
}

// ---------------------------------------------------------------------------
// Tickets de soporte (web pública /tickets): reclamo, verificación o soporte
// técnico sobre una compra. Aparte de ContactoWeb: llevan datos de la compra,
// evidencia y un flujo de atención propio.
// ---------------------------------------------------------------------------

enum TipoTicket {
  RECLAMO
  VERIFICACION
  SOPORTE
}

enum EstadoTicket {
  NUEVO
  EN_REVISION
  ESPERANDO_CLIENTE
  RESUELTO
  CERRADO
}

enum PrioridadTicket {
  BAJA
  NORMAL
  ALTA
  URGENTE
}

enum AutorTicket {
  CLIENTE
  EQUIPO
  SISTEMA
}

model Ticket {
  id           String          @id @default(uuid())
  marcaId      String
  marca        Marca           @relation(fields: [marcaId], references: [id])
  numero       String // correlativo humano TCK-AAAA-XXXXXX, único por marca
  tipo         TipoTicket
  estado       EstadoTicket    @default(NUEVO)
  esEmpresa    Boolean         @default(false)
  documento    String? // DNI o RUC
  nombre       String
  email        String
  celular      String?
  numeroCompra String?
  fechaCompra  String?
  producto     String?
  comprobante  String?
  descripcion  String
  evidencias   String[] // URLs de archivos subidos
  origen       String?
  notas        String?
  atendidoPor  String?
  prioridad    PrioridadTicket @default(NORMAL)
  asignadoA    String? // email del usuario responsable
  resueltoAt   DateTime?
  mensajes     TicketMensaje[]
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  @@unique([marcaId, numero])
  @@index([marcaId, estado, createdAt])
  @@index([marcaId, email])
}

// Conversación del ticket: respuestas del cliente y del equipo, notas internas (no las ve el cliente) y
// eventos del sistema (cambios de estado), en orden cronológico.
model TicketMensaje {
  id          String      @id @default(uuid())
  ticketId    String
  ticket      Ticket      @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  marcaId     String
  autor       AutorTicket
  autorNombre String?
  texto       String
  adjuntos    String[]
  interno     Boolean     @default(false)
  createdAt   DateTime    @default(now())

  @@index([ticketId, createdAt])
}

// ---------------------------------------------------------------------------
// Recursos para socios (partners): material de marcas (logos, fichas, banners,
// videos, catálogos) que el equipo sube desde el dashboard y los socios
// descargan en /recursos. Un Socio es un correo autorizado por el equipo.
// ---------------------------------------------------------------------------

enum EstadoSocio {
  PENDIENTE
  ACTIVO
  SUSPENDIDO
  RECHAZADO
}

enum TipoRecurso {
  IMAGEN
  PDF
  VIDEO
  DOCUMENTO
  OTRO
}

model Socio {
  id           String      @id @default(uuid())
  marcaId      String
  marca        Marca       @relation(fields: [marcaId], references: [id])
  email        String
  nombre       String?
  empresa      String?
  ruc          String?
  cargo        String?
  celular      String?
  mensaje      String? // lo que escribió al registrarse
  notas        String? // notas internas del equipo
  estado       EstadoSocio @default(PENDIENTE)
  aprobadoPor  String?
  aprobadoAt   DateTime?
  ultimoAcceso DateTime?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  @@unique([marcaId, email])
  @@index([marcaId, estado])
}

model Recurso {
  id          String      @id @default(uuid())
  marcaId     String
  marca       Marca       @relation(fields: [marcaId], references: [id])
  titulo      String
  descripcion String?
  tipo        TipoRecurso
  fabricante  String? // marca del fabricante: Dell, HP, Lenovo…
  categoria   String? // Logos, Fichas técnicas, Banners, Catálogos, Videos…
  archivoUrl  String // clave privada `<marcaId>/recursos/<uuid>.<ext>` en la carpeta no pública; se descarga solo con sesión
  mime        String?
  bytes       Int         @default(0)
  visible     Boolean     @default(true)
  orden       Int         @default(0)
  descargas   Int         @default(0)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  @@index([marcaId, visible, fabricante])
}

// Tarjeta digital del equipo comercial (página pública /tarjeta/:slug con QR y vCard). Una por persona y marca.
model TarjetaDigital {
  id        String   @id @default(uuid())
  marcaId   String
  marca     Marca    @relation(fields: [marcaId], references: [id])
  usuarioId String
  slug      String // /tarjeta/<slug>, único por marca
  nombre    String
  cargo     String?
  area      String?
  bio       String?
  fotoUrl   String?
  telefono  String?
  whatsapp  String? // solo dígitos con código de país
  email     String?
  linkedin  String?
  web       String?
  agendaUrl String? // enlace para reservar una reunión (Calendly, Google Calendar…)
  enlaces   Json     @default("[]") // [{ titulo, url }]
  activo    Boolean  @default(true)
  vistas    Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([marcaId, slug])
  @@unique([marcaId, usuarioId])
}
