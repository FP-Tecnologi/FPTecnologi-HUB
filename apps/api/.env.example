DATABASE_URL="postgresql://postgres:postgres@localhost:55432/fptecnologi?schema=public"
# Supabase: usar el pooler (Supavisor), la conexión directa db.<ref>.supabase.co
# es IPv6-only y no conecta desde redes sin salida IPv6.
#   postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
# Puerto 5432 (session pooler) para `prisma migrate` (usa advisory locks);
# puerto 6543 (transaction pooler, agregar ?pgbouncer=true) sirve para la app en runtime.
# <region> = "Project region" en Project Settings > General (ej. us-west-2).

# JWT
JWT_ACCESS_SECRET="change-me-access-secret"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_SECRET="change-me-refresh-secret"
JWT_REFRESH_EXPIRES_IN="7d"

# OTP (2FA)
OTP_EXPIRES_IN_MINUTES=10

# Resend (correo transaccional) — pendiente, se usara mas adelante en produccion
RESEND_API_KEY="change-me-resend-api-key"
RESEND_FROM_EMAIL="no-reply@fptecnologi.com"

# Correo — driver activo: smtp (pruebas internas) | resend (cambiar solo esto cuando este listo)
MAIL_DRIVER=smtp
MAIL_FROM_EMAIL="change-me-from-email"
SMTP_HOST="change-me-smtp-host"
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER="change-me-smtp-user"
SMTP_PASS="change-me-smtp-pass"

# Google OAuth (login con Google) — console.cloud.google.com > APIs y servicios > Credenciales
GOOGLE_CLIENT_ID="change-me-google-client-id"
GOOGLE_CLIENT_SECRET="change-me-google-client-secret"
GOOGLE_CALLBACK_URL="http://localhost:3001/auth/google/callback"

# Origen del dashboard (CORS con credenciales + redirect final del login de Google)
WEB_ORIGIN="http://localhost:3000"

# App
PORT=3001
NODE_ENV=development

# Swagger (/docs) — requeridas solo cuando NODE_ENV=production; en
# desarrollo /docs queda sin auth para no trabar el flujo local.
SWAGGER_USER="change-me-swagger-user"
SWAGGER_PASSWORD="change-me-swagger-password"

# Shalom (envíos): directorio vivo de agencias, endpoints públicos sin key.
# Solo se usa para listar agencias; el tarifario y la cotización siguen siendo propios.
# SHALOM_API_URL="https://api.shalom-api.lat"

# URL pública de ESTA API (la que ve el navegador). Se usa para armar el enlace de las imágenes subidas
# desde el dashboard: https://api.tudominio.com
PUBLIC_API_URL="http://localhost:3001"

# Carpeta (relativa a la carpeta de la API) donde se guardan las imágenes subidas. En cPanel debe sobrevivir a los
# despliegues: usa una ruta fuera de la carpeta que se reemplaza, por ejemplo ../uploads-fptecnologi
UPLOADS_DIR="uploads"


# URL pública de la web (enlaces de los correos: seguimiento de tickets, presupuestos, intranet de socios)
WEB_PUBLICA_URL="http://localhost:3002"

# Almacén privado (recursos de socios y evidencias de tickets): fuera de la carpeta que se reemplaza al desplegar
UPLOADS_PRIVADO_DIR="uploads-privado"

# Antivirus opcional (ClamAV, clamd por TCP). Sin CLAMAV_HOST solo corre el filtro básico del propio servidor.
# CLAMAV_HOST="127.0.0.1"
# CLAMAV_PORT=3310
# CLAMAV_OPCIONAL=1   # si clamd no responde, aceptar igual (por defecto se rechaza)

# Proxy: saltos de proxy delante de la API para leer la IP real del cliente (0 si se expone directo)
# TRUST_PROXY=1
