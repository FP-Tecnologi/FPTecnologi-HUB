# Copiar a .env.local (ignorado por git) y completar.
# Asistente virtual del chat (app/api/chat/route.ts) -- key de https://console.groq.com/keys
GROQ_API_KEY=
# Opcional: modelo de Groq (default openai/gpt-oss-20b)
GROQ_MODEL=
# Opcional: otro modelo de Groq si el principal se queda sin cupo por minuto (429). Ej.: llama-3.1-8b-instant
GROQ_MODEL_RESERVA=
# Opcional: 1 = servir las fotos sin redimensionar en el servidor (menos RAM en hostings chicos)
NEXT_IMAGENES_SIN_OPTIMIZAR=

# Chat conectado al dashboard (app/api/hub/chat): URL de la API central y
# marcaId de FPTecnologi (GET /public/marcas). Sin HUB_MARCA_ID el chat
# funciona igual, solo sin guardar conversaciones ni asesores desde la API.
# Las mismas dos variables alimentan el Libro de Reclamaciones (app/api/hub/libro-reclamaciones y
# GET /public/libro-reclamaciones/proveedor): sin HUB_MARCA_ID el proxy responde 503 y la página usa
# los datos del proveedor de respaldo (src/lib/proveedorLibro.ts).
HUB_API_URL=http://localhost:3001
HUB_MARCA_ID=

# Copia opcional de los contactos al sistema externo de Centralización de Leads
# (Supabase). Sin estas dos variables solo se guarda en el HUB.
LEADS_SUPABASE_URL=
LEADS_SUPABASE_ANON_KEY=

# URL pública del sitio (sitemap, canonical y Open Graph)
SITE_URL=https://fptecnologi.com

# 1 = sitio de pruebas en un subdominio: robots.txt y metadatos piden NO indexar (quítalo al pasar al dominio principal)
NOINDEX=0

# URL del dashboard (https://...): permite que su editor lea el contenido de la web (app/api/cms)
DASHBOARD_ORIGIN=http://localhost:3000
