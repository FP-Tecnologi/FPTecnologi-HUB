# Copiar a .env.local (ignorado por git) y completar.
# Asistente virtual del chat (app/api/chat/route.ts) -- key de https://console.groq.com/keys
GROQ_API_KEY=
# Opcional: modelo de Groq (default openai/gpt-oss-20b)
GROQ_MODEL=

# Chat conectado al dashboard (app/api/hub/chat): URL de la API central y
# marcaId de FPTecnologi (GET /public/marcas). Sin HUB_MARCA_ID el chat
# funciona igual, solo sin guardar conversaciones ni asesores desde la API.
HUB_API_URL=http://localhost:3001
HUB_MARCA_ID=

# Copia opcional de los contactos al sistema externo de Centralización de Leads
# (Supabase). Sin estas dos variables solo se guarda en el HUB.
LEADS_SUPABASE_URL=
LEADS_SUPABASE_ANON_KEY=
