# API central del HUB y id de la marca Quamtu (para que /cotizar guarde las solicitudes como leads).
# Sin HUB_MARCA_ID el cotizador sigue funcionando, solo por WhatsApp.
HUB_API_URL=http://localhost:3001
HUB_MARCA_ID=
# El Libro de Reclamaciones (/libro-de-reclamaciones) usa estas mismas dos variables:
# sin HUB_MARCA_ID muestra los datos de respaldo y ofrece WhatsApp si no se puede registrar la hoja.
