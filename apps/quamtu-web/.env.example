# Web estática: estas variables se leen al COMPILAR (npm run build) y quedan dentro de los archivos de out/.
# HUB_* → el servidor de compilación lee contenido (CMS, proveedor). NEXT_PUBLIC_HUB_* → el navegador envía formularios a la API.
# Sin HUB_MARCA_ID / NEXT_PUBLIC_HUB_MARCA_ID los formularios caen a WhatsApp / correo.
HUB_API_URL=
HUB_MARCA_ID=
NEXT_PUBLIC_HUB_API_URL=
NEXT_PUBLIC_HUB_MARCA_ID=
