# API central del HUB y marcaId de fimavperu (tabla Marca). Sin HUB_MARCA_ID el cotizador, el contacto y el libro de reclamaciones responden 503 (los formularios muestran su respaldo por WhatsApp/correo).
HUB_API_URL=http://localhost:3001
HUB_MARCA_ID=

# Opcional: CDN solo para archivos (p. ej. https://cdn.midominio.com). Sin esta variable no cambia nada. Ver docs/CDN-CLOUDFLARE.md.
CDN_URL=

# marcaId de FPTecnologi (GET /public/marcas): la tienda (/tienda) muestra sus productos con el estilo de Fimav. Sin esta variable la tienda avisa que no esta disponible y deriva a /cotizar.
TIENDA_MARCA_ID=
