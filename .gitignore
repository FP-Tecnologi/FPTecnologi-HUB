apps/web-fptecnologi/videos-originales/

# Credenciales reales de cuentas de prueba (contraseñas en texto plano)
docs/credenciales-prueba.md

# Variables de entorno con credenciales reales (nunca se versionan; usar
# los *.example como plantilla)
envs/
.env
.env.local
.env.*.local

# Imágenes subidas desde el dashboard (se guardan en el servidor, no en git)
apps/api/uploads/
apps/api/uploads-privado/

# Paquetes para subir al hosting (se generan con git archive)
*.zip
